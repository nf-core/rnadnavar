/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing the interval scatter/gather path
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to exercise scatter/gather over more than
    one interval, which `test` and `test_full` cannot do because they set no_intervals.

    Use as follows:
        nextflow run nf-core/rnadnavar -profile test_intervals,<docker/singularity> --outdir <OUTDIR>

    This profile deliberately does NOT use the chr7 data from the other test profiles. Those
    CRAMs are aligned against the real GRCh38 chr7 (LN:159345973) while the mini reference
    GRCh38.d1.vd1.chr7.mini.fa is truncated to 39000001 bp. Strelka tolerates that, but GATK
    refuses to run when the reference and the reads disagree on contig length, so no GATK
    preprocessing step can read them. The chr21 data below comes from the modules branch of
    nf-core/test-datasets, where reference, CRAMs and intervals are mutually consistent.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '4.h'
    ]
}

params {
    config_profile_name        = 'Interval scatter/gather test profile'
    config_profile_description = 'Minimal test dataset scattered over two intervals'

    // I/O opts
    input  = "${projectDir}/tests/csv/cram_pair_chr21.csv"
    outdir = 'rnadnavar_test_intervals'

    // Matched tumour/normal DNA pair, already recalibrated, so start at BQSR.
    // No RNA sample, so no STAR index is built.
    rna  = false
    step = 'prepare_recalibration'

    // chr21 reference, consistent with the CRAMs in the samplesheet
    genome          = null
    igenomes_ignore = true
    fasta           = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/genome.fasta'
    fasta_fai       = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai'
    dict            = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/genome.dict'
    dbsnp           = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/germlineresources/dbsnp_138.hg38.vcf.gz'
    dbsnp_tbi       = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/germlineresources/dbsnp_138.hg38.vcf.gz.tbi'

    // Scatter over two intervals.
    // CREATE_INTERVALS_BED only opens a new chunk once the accumulated runtime estimate
    // ((end - start) / nucleotides_per_second) passes 600s, so with the default 200000 this
    // BED collapses into a single chunk and nothing is scattered.
    wes                    = true
    no_intervals           = false
    intervals              = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed'
    nucleotides_per_second = 20

    // Publish the split interval BEDs so the test can assert that the scatter happened
    save_reference = true

    tools = 'strelka'
}
